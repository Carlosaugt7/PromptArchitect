// OmniForge Firestore Security Rules
// Copie este conteúdo em:
// Firebase Console → Firestore Database → Rules → Edit rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    // REGRAS DE DESENVOLVIMENTO — permite acesso para testar
    // ⚠️ MUDE para as regras de produção antes de publicar!
    // ══════════════════════════════════════════════════════════
    
    // Modo temporário: permite leitura/escrita para qualquer usuário autenticado
    // Útil durante desenvolvimento local
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

